meta {
  name: Get current user statistics
  type: http
  seq: 2
  tags: [
    Statistics
  ]
}

get {
  url: {{baseUrl}}/stats/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  Retrieves statistics specific to the authenticated user's collection
}

example {
  name: 200 Response
  description: User statistics retrieved successfully
  
  request: {
    url: {{baseUrl}}/stats/me
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "totalWorks": 0,
          "totalVolumes": 0,
          "completedWorks": 0,
          "onGoingWorks": 0,
          "wishlistItems": 0,
          "totalMangas": 0,
          "totalComics": 0,
          "totalGraphicNovels": 0,
          "totalManhwas": 0
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized - invalid or missing JWT token
  
  request: {
    url: {{baseUrl}}/stats/me
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
        {
          "totalWorks": 0,
          "totalVolumes": 0,
          "completedWorks": 0,
          "onGoingWorks": 0,
          "wishlistItems": 0,
          "totalMangas": 0,
          "totalComics": 0,
          "totalGraphicNovels": 0,
          "totalManhwas": 0
        }
      '''
    }
  }
}
