meta {
  name: Create a new work
  type: http
  seq: 5
  tags: [
    Works
  ]
}

post {
  url: {{baseUrl}}/works
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "",
    "type": "MANGA",
    "publisher": "",
    "author": "",
    "totalVolumes": 0,
    "coverUrl": ""
  }
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  Creates a new work in the catalog
}

example {
  name: 201 Response
  description: Work created successfully
  
  request: {
    url: {{baseUrl}}/works
    method: POST
    mode: json
    body:json: {
      {
        "title": "",
        "type": "MANGA",
        "publisher": "",
        "author": "",
        "totalVolumes": 0,
        "coverUrl": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "title": "",
          "type": "MANGA",
          "publisher": "",
          "author": "",
          "totalVolumes": 0,
          "coverUrl": ""
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Invalid payload or validation error
  
  request: {
    url: {{baseUrl}}/works
    method: POST
    mode: json
    body:json: {
      {
        "title": "",
        "type": "MANGA",
        "publisher": "",
        "author": "",
        "totalVolumes": 0,
        "coverUrl": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "title": "",
          "type": "MANGA",
          "publisher": "",
          "author": "",
          "totalVolumes": 0,
          "coverUrl": ""
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized - invalid or missing JWT token
  
  request: {
    url: {{baseUrl}}/works
    method: POST
    mode: json
    body:json: {
      {
        "title": "",
        "type": "MANGA",
        "publisher": "",
        "author": "",
        "totalVolumes": 0,
        "coverUrl": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "title": "",
          "type": "MANGA",
          "publisher": "",
          "author": "",
          "totalVolumes": 0,
          "coverUrl": ""
        }
      '''
    }
  }
}
