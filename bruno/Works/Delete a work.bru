meta {
  name: Delete a work
  type: http
  seq: 3
  tags: [
    Works
  ]
}

delete {
  url: {{baseUrl}}/works/:id
  body: none
  auth: bearer
}

params:path {
  @description('ID of the work')
  id: 
}

auth:bearer {
  token: {{token}}
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  Deletes a specific work by its ID
}

example {
  name: 204 Response
  description: Work deleted successfully
  
  request: {
    url: {{baseUrl}}/works/:id
