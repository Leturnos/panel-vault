meta {
  name: Remove work from user collection
  type: http
  seq: 3
  tags: [
    User_Collection
  ]
}

delete {
  url: {{baseUrl}}/works/:workId/collection
  body: none
  auth: bearer
}

params:path {
  @description('ID of the work')
  workId: 
}

auth:bearer {
  token: {{token}}
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  Removes a work from the authenticated user's collection
}

example {
  name: 204 Response
  description: Work removed from collection successfully
  
  request: {
    url: {{baseUrl}}/works/:workId/collection
    method: DELETE
    mode: none
    params:path: {
      workId: 
    }
  }
  
  response: {
    status: {
      code: 204
      text: No Content
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized - invalid or missing JWT token
  
  request: {
    url: {{baseUrl}}/works/:workId/collection
    method: DELETE
    mode: none
    params:path: {
      workId: 
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 404 Response
  description: Collection entry not found
  
  request: {
    url: {{baseUrl}}/works/:workId/collection
    method: DELETE
    mode: none
    params:path: {
      workId: 
    }
  }
  
  response: {
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
