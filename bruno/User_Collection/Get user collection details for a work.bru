meta {
  name: Get user collection details for a work
  type: http
  seq: 1
  tags: [
    User_Collection
  ]
}

get {
  url: {{baseUrl}}/works/:workId/collection
  body: none
  auth: bearer
}

params:path {
  @description('ID of the work')
  workId: 
}

auth:bearer {
  token: {{token}}
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  Retrieves user-specific tracking details for the specified work
}

example {
  name: 200 Response
  description: Collection entry retrieved successfully
  
  request: {
    url: {{baseUrl}}/works/:workId/collection
    method: GET
    mode: none
    params:path: {
      workId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "workId": 0,
          "workTitle": "",
          "status": "COMPLETED",
          "rating": 0
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized - invalid or missing JWT token
  
  request: {
    url: {{baseUrl}}/works/:workId/collection
    method: GET
    mode: none
    params:path: {
      workId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "workId": 0,
          "workTitle": "",
          "status": "COMPLETED",
          "rating": 0
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Work or collection entry not found
  
  request: {
    url: {{baseUrl}}/works/:workId/collection
    method: GET
    mode: none
    params:path: {
      workId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "workId": 0,
          "workTitle": "",
          "status": "COMPLETED",
          "rating": 0
        }
      '''
    }
  }
}
