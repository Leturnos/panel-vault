meta {
  name: Add or update work in user collection
  type: http
  seq: 2
  tags: [
    User_Collection
  ]
}

put {
  url: {{baseUrl}}/works/:workId/collection
  body: json
  auth: bearer
}

params:path {
  @description('ID of the work')
  workId: 
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "status": "COMPLETED",
    "rating": 0,
    "ratingStepValid": false
  }
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  Saves or updates tracking details (reading status, rating, etc.) for a work in the authenticated user's collection
}

example {
  name: 200 Response
  description: Collection entry saved or updated successfully
  
  request: {
    url: {{baseUrl}}/works/:workId/collection
    method: PUT
    mode: json
    params:path: {
      workId: 
    }
  
    body:json: {
      {
        "status": "COMPLETED",
        "rating": 0,
        "ratingStepValid": false
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "workId": 0,
          "workTitle": "",
          "status": "COMPLETED",
          "rating": 0
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Invalid payload or validation error
  
  request: {
    url: {{baseUrl}}/works/:workId/collection
    method: PUT
    mode: json
    params:path: {
      workId: 
    }
  
    body:json: {
      {
        "status": "COMPLETED",
        "rating": 0,
        "ratingStepValid": false
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "workId": 0,
          "workTitle": "",
          "status": "COMPLETED",
          "rating": 0
        }
      '''
    }
  }
}

