  name: 401 Response
  description: Unauthorized - invalid or missing JWT token
  
  request: {
    url: {{baseUrl}}/works/:workId/collection
    method: PUT
    mode: json
    params:path: {
      workId: 
    }
  
    body:json: {
      {
        "status": "COMPLETED",
        "rating": 0,
        "ratingStepValid": false
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "workId": 0,
          "workTitle": "",
          "status": "COMPLETED",
          "rating": 0
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Work not found
  
  request: {
    url: {{baseUrl}}/works/:workId/collection
    method: PUT
    mode: json
    params:path: {
      workId: 
    }
  
    body:json: {
      {
        "status": "COMPLETED",
        "rating": 0,
        "ratingStepValid": false
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "workId": 0,
          "workTitle": "",
          "status": "COMPLETED",
          "rating": 0
        }
      '''
    }
  }
}
