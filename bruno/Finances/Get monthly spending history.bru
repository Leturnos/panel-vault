meta {
  name: Get monthly spending history
  type: http
  seq: 4
  tags: [
    Finances
  ]
}

get {
  url: {{baseUrl}}/finances/history
  body: none
  auth: bearer
}

params:query {
  @description('Filter by year (e.g. 2026). Ignored if startDate or endDate are provided.')
  ~year: 
  @description('Start of the date range (inclusive). Format: yyyy-MM-dd.')
  ~startDate: 
  @description('End of the date range (inclusive). Format: yyyy-MM-dd.')
  ~endDate: 
}

auth:bearer {
  token: {{token}}
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  Returns the authenticated user's purchase history grouped by month. Filter by a specific year using the 'year' parameter, or by an arbitrary date range using 'startDate' and 'endDate'. If no filter is provided, the full history is returned.
}

example {
  name: 200 Response
  description: Monthly expense history retrieved successfully
  
  request: {
    url: {{baseUrl}}/finances/history
    method: GET
    mode: none
    params:query: {
      ~year: 
      ~startDate: 
      ~endDate: 
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        [
          {
            "year": 0,
            "month": 0,
            "totalSpent": 0,
            "volumeCount": 0
          }
        ]
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized - invalid or missing JWT token
  
  request: {
    url: {{baseUrl}}/finances/history
    method: GET
    mode: none
    params:query: {
      ~year: 
      ~startDate: 
      ~endDate: 
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
        [
          {
            "year": 0,
            "month": 0,
            "totalSpent": 0,
            "volumeCount": 0
          }
        ]
      '''
    }
  }
}
