meta {
  name: Get financial summary
  type: http
  seq: 3
  tags: [
    Finances
  ]
}

get {
  url: {{baseUrl}}/finances/summary
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  Retrieves an overview of the authenticated user's collection spending, including total invested, average price per volume, highest and lowest prices paid, and an estimated cost to complete the entire collection.
}

example {
  name: 200 Response
  description: Financial summary retrieved successfully
  
  request: {
    url: {{baseUrl}}/finances/summary
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "totalSpent": 0,
          "totalVolumesWithPrice": 0,
          "averageVolumePrice": 0,
          "highestPrice": 0,
          "lowestPrice": 0,
          "estimatedToCompleteCollection": 0
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized - invalid or missing JWT token
  
  request: {
    url: {{baseUrl}}/finances/summary
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
        {
          "totalSpent": 0,
          "totalVolumesWithPrice": 0,
          "averageVolumePrice": 0,
          "highestPrice": 0,
          "lowestPrice": 0,
          "estimatedToCompleteCollection": 0
        }
      '''
    }
  }
}
