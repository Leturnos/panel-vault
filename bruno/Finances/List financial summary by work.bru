meta {
  name: List financial summary by work
  type: http
  seq: 1
  tags: [
    Finances
  ]
}

get {
  url: {{baseUrl}}/finances/works
  body: none
  auth: bearer
}

params:query {
  @description('Zero-based page index (0..N)')
  page: 0
  @description('The size of the page to be returned')
  size: 20
  @description('Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.')
  ~sort: []
}

auth:bearer {
  token: {{token}}
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  Returns a paginated list of all works in the authenticated user's collection with their respective financial data, such as total spent and estimated cost to complete each work.
}

example {
  name: 200 Response
  description: Works financial summary retrieved successfully
  
  request: {
    url: {{baseUrl}}/finances/works
    method: GET
    mode: none
    params:query: {
      page: 0
      size: 20
      ~sort: []
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "totalPages": 0,
          "totalElements": 0,
          "size": 0,
          "content": [
            {
              "workId": 0,
              "workTitle": "",
              "totalSpent": 0,
              "ownedVolumesCount": 0,
              "totalVolumes": 0,
              "averagePricePaid": 0,
              "estimatedRemainingCost": 0
            }
          ],
          "number": 0,
          "sort": {
            "empty": false,
            "sorted": false,
            "unsorted": false
          },
          "pageable": {
            "offset": 0,
            "paged": false,
            "pageNumber": 0,
            "pageSize": 0,
            "sort": {
              "empty": false,
              "sorted": false,
              "unsorted": false
            },
            "unpaged": false
          },
          "numberOfElements": 0,
          "first": false,
          "last": false,
          "empty": false
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized - invalid or missing JWT token
  
  request: {
    url: {{baseUrl}}/finances/works
    method: GET
    mode: none
    params:query: {
      page: 0
      size: 20
      ~sort: []
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
        {
          "totalPages": 0,
          "totalElements": 0,
          "size": 0,
          "content": [
            {
              "workId": 0,
              "workTitle": "",
              "totalSpent": 0,
              "ownedVolumesCount": 0,
              "totalVolumes": 0,
              "averagePricePaid": 0,
              "estimatedRemainingCost": 0
            }
          ],
          "number": 0,
          "sort": {
            "empty": false,
            "sorted": false,
            "unsorted": false
          },
          "pageable": {
            "offset": 0,
            "paged": false,
            "pageNumber": 0,
            "pageSize": 0,
            "sort": {
              "empty": false,
              "sorted": false,
              "unsorted": false
            },
            "unpaged": false
          },
          "numberOfElements": 0,
          "first": false,
          "last": false,
          "empty": false
        }
      '''
    }
  }
}
