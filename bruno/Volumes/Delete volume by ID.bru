meta {
  name: Delete volume by ID
  type: http
  seq: 4
  tags: [
    Volumes
  ]
}

delete {
  url: {{baseUrl}}/volumes/:id
  body: none
  auth: bearer
}

params:path {
  @description('ID of the volume')
  id: 
}

auth:bearer {
  token: {{token}}
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  Deletes a specific volume by its ID
}

