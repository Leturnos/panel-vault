meta {
  name: Add a volume to a work
  type: http
  seq: 1
  tags: [
    Volumes
  ]
}

post {
  url: {{baseUrl}}/works/:id/volumes
  body: json
  auth: bearer
}

params:path {
  @description('ID of the work')
  id: 
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "number": 0,
    "purchaseDate": "",
    "purchasePrice": 0,
    "owned": false
  }
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  Creates and associates a new volume with the specified work
}

example {
  name: 201 Response
  description: Volume created successfully
  
  request: {
    url: {{baseUrl}}/works/:id/volumes
    method: POST
    mode: json
    params:path: {
      id: 
    }
  
    body:json: {
      {
        "number": 0,
        "purchaseDate": "",
        "purchasePrice": 0,
        "owned": false
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "number": 0,
          "purchaseDate": "",
          "purchasePrice": 0,
          "owned": false,
          "workId": 0
        }
      '''
    }
  }
}

