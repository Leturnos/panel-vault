meta {
  name: List all volumes of a work
  type: http
  seq: 2
  tags: [
    Volumes
  ]
}

get {
  url: {{baseUrl}}/works/:workId/volumes
  body: none
  auth: bearer
}

params:path {
  @description('ID of the work')
  workId: 
}

auth:bearer {
  token: {{token}}
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  Retrieves all volumes associated with the specified work
}

example {
  name: 200 Response
  description: Volumes retrieved successfully
  
  request: {
    url: {{baseUrl}}/works/:workId/volumes
    method: GET
    mode: none
    params:path: {
      workId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        [
          {
            "id": 0,
            "number": 0,
            "purchaseDate": "",
            "purchasePrice": 0,
            "owned": false,
            "workId": 0
          }
        ]
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized - invalid or missing JWT token
  
  request: {
    url: {{baseUrl}}/works/:workId/volumes
    method: GET
    mode: none
    params:path: {
      workId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
        [
          {
            "id": 0,
            "number": 0,
            "purchaseDate": "",
            "purchasePrice": 0,
            "owned": false,
            "workId": 0
          }
        ]
      '''
    }
  }
}

example {
  name: 404 Response
  description: Work not found
  
  request: {
    url: {{baseUrl}}/works/:workId/volumes
    method: GET
    mode: none
    params:path: {
      workId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
        [
          {
            "id": 0,
            "number": 0,
            "purchaseDate": "",
            "purchasePrice": 0,
            "owned": false,
            "workId": 0
          }
        ]
      '''
    }
  }
}
