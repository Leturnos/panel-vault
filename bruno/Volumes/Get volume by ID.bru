meta {
  name: Get volume by ID
  type: http
  seq: 3
  tags: [
    Volumes
  ]
}

get {
  url: {{baseUrl}}/volumes/:id
  body: none
  auth: bearer
}

params:path {
  @description('ID of the volume')
  id: 
}

auth:bearer {
  token: {{token}}
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  Retrieves details of a specific volume by its ID
}

example {
  name: 200 Response
  description: Volume retrieved successfully
  
  request: {
    url: {{baseUrl}}/volumes/:id
    method: GET
    mode: none
    params:path: {
      id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "number": 0,
          "purchaseDate": "",
          "purchasePrice": 0,
          "owned": false,
          "workId": 0
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized - invalid or missing JWT token
  
  request: {
    url: {{baseUrl}}/volumes/:id
    method: GET
    mode: none
    params:path: {
      id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "number": 0,
          "purchaseDate": "",
          "purchasePrice": 0,
          "owned": false,
          "workId": 0
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Volume not found
  
  request: {
    url: {{baseUrl}}/volumes/:id
    method: GET
    mode: none
    params:path: {
      id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
        {
          "id": 0,
          "number": 0,
          "purchaseDate": "",
          "purchasePrice": 0,
          "owned": false,
          "workId": 0
        }
      '''
    }
  }
}
